# ---------------------------------------------------------------------------
# Recall — environment configuration
# Copy this file to `.env` and fill in the values you need.
# Everything is optional: without AI and Stripe keys the app still runs, with
# manual flashcards, spaced repetition and the free plan fully working.
# ---------------------------------------------------------------------------

# --- Server ---------------------------------------------------------------
PORT=3000
NODE_ENV=development
# Public base URL, used for Stripe redirects and password-reset links.
APP_BASE_URL=http://localhost:3000
# Set to 1 when serving over HTTPS so session cookies get the Secure flag.
RECALL_SECURE_COOKIES=0

# --- Storage --------------------------------------------------------------
# SQLite database file and private upload directory.
RECALL_DB_PATH=./data/recall.db
RECALL_UPLOAD_DIR=./data/uploads
RECALL_MAX_UPLOAD_BYTES=15728640
RECALL_MAX_TEXT_CHARS=200000

# --- AI provider ----------------------------------------------------------
# One of: gemini | openai | anthropic | none
AI_PROVIDER=gemini
# Model name for the chosen provider.
AI_MODEL=gemini-2.5-flash
# Google Gemini (AI Studio)
GEMINI_API_KEY=
# Optional: a gateway/proxy base URL. When set, the request is sent to
# {GEMINI_BASE_URL}/models/{AI_MODEL}:streamGenerateContent
GEMINI_BASE_URL=
# Optional: token used as the x-goog-api-key header when going through a gateway.
GENAI_PROXY_TOKEN=
# Optional: User-Agent sent to a gateway (some gateways allowlist it).
AI_USER_AGENT=creao-skill-html/1.0
# OpenAI
OPENAI_API_KEY=
OPENAI_BASE_URL=
# Anthropic
ANTHROPIC_API_KEY=
ANTHROPIC_BASE_URL=
# Cost / reliability controls
AI_MAX_INPUT_CHARS=24000
AI_TIMEOUT_MS=90000
AI_MAX_RETRIES=2

# --- Email (password reset delivery) --------------------------------------
# Transport: auto | smtp | file | console | none
#   auto    smtp when SMTP_HOST is set, otherwise file/console
#   smtp    real delivery through your provider (requires nodemailer)
#   file    writes each message to RECALL_MAIL_OUTBOX_DIR (ideal for dev/tests)
#   console prints the message to the server log
#   none    disables sending entirely
RECALL_MAIL_TRANSPORT=auto
SMTP_HOST=
SMTP_PORT=587
# Leave blank to infer from the port (465 = implicit TLS, 587 = STARTTLS).
SMTP_SECURE=
SMTP_USER=
SMTP_PASS=
# From address, e.g. "Recall <no-reply@yourdomain.com>". Falls back to SMTP_USER.
MAIL_FROM=
MAIL_FROM_NAME=Recall
SMTP_TIMEOUT_MS=15000
# Only used by the "file" transport. Defaults to ./data/outbox.
RECALL_MAIL_OUTBOX_DIR=
# How long a password-reset link stays valid.
RECALL_RESET_TOKEN_MINUTES=60
# Minimum seconds between reset emails to the same address (anti-abuse).
RECALL_RESET_COOLDOWN_MS=60000

# --- Billing (Stripe) -----------------------------------------------------
# Preferred for a quick start: create two Payment Links in Stripe, one monthly
# and one annual. Recall appends `client_reference_id` to attribute the purchase.
STRIPE_PAYMENT_LINK_MONTHLY=
STRIPE_PAYMENT_LINK_ANNUAL=
# Alternative: server-created Checkout Sessions from price IDs.
STRIPE_SECRET_KEY=
STRIPE_PRICE_PLUS_MONTHLY=
STRIPE_PRICE_PLUS_ANNUAL=
# Required for both modes: signing secret of the webhook that points at
# POST {APP_BASE_URL}/api/billing/webhook
STRIPE_WEBHOOK_SECRET=

# --- Development only -----------------------------------------------------
# Enables POST /api/billing/dev-activate so paid features can be exercised
# locally without Stripe. NEVER enable this in production.
RECALL_ALLOW_DEV_UPGRADE=0
# Also return password-reset links in the API response. Intended for local
# testing only — leave at 0 in production. Outside production the link is
# already shown whenever mail is not actually delivered over SMTP.
RECALL_EXPOSE_RESET_TOKEN=0
